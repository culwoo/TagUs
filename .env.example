# 환경 변수 예시

이 파일을 복사하여 `.env`로 이름을 변경하고 실제 값을 입력하세요.

# Gemini API Key (server)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS (server)
FRONTEND_URL=http://localhost:5173

# Firebase Admin Credentials (server / vercel functions)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"

# Firebase Configuration
# Firebase Console > Project Settings > General > Your apps 에서 확인
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# API Configuration
VITE_API_BASE_URL=/api

# Optional: Python path for background removal
PYTHON_PATH=python
